# Required in production (optional in local dev — defaults exist)
AUTH_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Explicit environment: LOCAL | TEST | STAGING | PRODUCTION
# APP_ENV=LOCAL

# Production host safety
# BACKUP_DIR must be off the live DB disk in production
# BACKUP_DIR=/mnt/backups/ledger
# Staff MFA is required by default when NODE_ENV=production
# REQUIRE_STAFF_MFA=1
# ENCRYPTION_KEY=   # optional; falls back to AUTH_SECRET for MFA/QBO ciphertext
# ENCRYPTION_KEY_PREVIOUS=  # during rotation only
# APP_VERSION=0.1.0
# GIT_COMMIT=
# DEPLOYMENT_ID=

# Kill switches (optional features — core financials stay up)
# AI_PROVIDER_ENABLED=1
# COPILOT_ENABLED=1

# Optional integrations — platform works with all off
RESEND_API_KEY=
RESEND_FROM=Hathorn Advisory <noreply@hathornadvisorygroup.com>

QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional overrides
# DATA_DIR=./data
# BACKUP_DIR=./data/backups

# Postgres migration tooling only (app runtime is still SQLite)
# DATABASE_URL=postgres://user:pass@host:5432/ledger

# Never set on a live book unless you intend to wipe it
# ALLOW_DEMO_SEED=1

# Optional Forge FP&A pilot (default off — Hathorn never requires Forge)
# FORGE_ENABLED=0
# FORGE_BIN=forge

# Optional Document Intelligence worker (default off — native CSV parse still works)
# DOCUMENT_INTELLIGENCE_ENABLED=0
# DOCLING_PYTHON=python3

# Tax Intelligence (native research workspace; default on)
# TAX_INTELLIGENCE_ENABLED=1
# IRS Fact Graph pilot (default off — BLOCKED without external Scala.js artifact)
# IRS_FACT_GRAPH_ENABLED=0
# IRS_FACT_GRAPH_MODULE=

# Accounting Guidance (native technical research; default on)
# ACCOUNTING_GUIDANCE_ENABLED=1
# RAGFlow retrieval pilot (default off — DEFERRED; native chunk search is supported)
# RAGFLOW_ENABLED=0

# Reconciliation intelligence (deterministic tie-outs; default on)
# RECONCILIATION_ENABLED=1

# Integration Hub (provider registry + sync history; default on)
# QuickBooks OAuth still uses QBO_* above; hub does not duplicate tokens.
# INTEGRATION_HUB_ENABLED=1

# Automated close + exception command center (default on; never auto-publishes)
# CLOSE_AUTOMATION_ENABLED=1


